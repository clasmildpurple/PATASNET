rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Settings collection (Company branding, logo, QRIS, Google Sheets URL)
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId);
    }

    // Customers collection (WiFi subscriber accounts & payments)
    match /customers/{customerId} {
      allow read: if isValidId(customerId);
      allow write: if isValidId(customerId);
    }

    // Support tickets
    match /tickets/{ticketId} {
      allow read: if isValidId(ticketId);
      allow write: if isValidId(ticketId);
    }
  }
}
